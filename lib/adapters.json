{
  "version": 1,
  "description": "eventloom adapter registry — declare one entry per capturable agent",
  "adapters": [
    {
      "agent": "omp",
      "method": "extension",
      "hook_path": "~/.omp/agent/extensions/eventloom.ts",
      "events": ["session", "tool", "approval", "model"],
      "watch": "hooks"
    },
    {
      "agent": "claude",
      "method": "hooks",
      "hook_path": "~/.claude/hooks/eventloom-hook.sh",
      "events": ["session", "tool"],
      "watch": "hooks"
    }
  ]
}
